@Tutorials(name: "AR 도미노 체인리액션") {
    @Intro(title: "AR 도미노 체인리액션 만들기") {
        ARDominoChainReaction은 카메라로 비추는 실제 공간에 가상 도미노를 세우고, 손끝으로 밀어
        연쇄 반응을 일으키는 AR 앱이에요.

        1장부터 6장까지 ARKit으로 공간을 인식하고, RealityKit으로 도미노를 세우고, 드래그로 밀어
        넘어뜨리는 체인리액션까지 완성한 뒤, 마지막엔 실사 3D 모델로 다듬습니다.

        Swift 기본 문법 정도는 알고 있어야 해요. 다만 ARKit이나 RealityKit, 3D 모델링은
        몰라도 괜찮아요. 평면 감지, 엔티티와 컴포넌트, 3D 좌표계, 충돌과 임펄스 같은 개념도
        코드를 짜면서 그때그때 설명해드릴게요!

        @Image(source: domino-blender-demo.gif, alt: "실제 USDZ 나무 모델로 재현한 Blender 애니메이션: 회색 바닥 위 도미노가 차례로 넘어지는 연쇄 반응")
    }

    @Chapter(name: "1. 프로젝트 준비") {
        AR 앱은 왜 카메라 권한과 실기기가 필요한가.

        @Image(source: feature-points-illustration.png, alt: "프로젝트 준비")

        @TutorialReference(tutorial: "doc:Chapter1-ProjectSetup")
    }

    @Chapter(name: "2. 기본 AR 씬 띄우기") {
        ARSession과 평면 감지, UIKit↔SwiftUI 통합.

        @Image(source: feature-points-illustration.png, alt: "기본 AR 씬 띄우기")

        @TutorialReference(tutorial: "doc:Chapter2-BasicARScene")
    }

    @Chapter(name: "3. 도미노 한 개 만들기") {
        RealityKit의 Entity-Component-System.

        @Image(source: domino-entity-hero.png, alt: "도미노 한 개 만들기")

        @TutorialReference(tutorial: "doc:Chapter3-DominoEntity")
    }

    @Chapter(name: "4. 탭으로 하나씩 배치하기") {
        Raycasting과 보이지 않는 물리 바닥.

        @Image(source: tap-placement-hero.png, alt: "탭으로 하나씩 배치하기")

        @TutorialReference(tutorial: "doc:Chapter4-TapPlacement")
    }

    @Chapter(name: "5. 드래그로 밀어 넘어뜨리기") {
        좌표계 변환과 Impulse.

        @Image(source: finger-drag-domino-illustration.png, alt: "드래그로 밀어 넘어뜨리기")

        @TutorialReference(tutorial: "doc:Chapter5-DragToPush")
    }

    @Chapter(name: "6. USDZ 모델로 다듬기") {
        절차적 mesh에서 USDZ 에셋으로.

        @Image(source: mesh-usdz-actual-comparison.png, alt: "USDZ 모델로 다듬기")

        @TutorialReference(tutorial: "doc:Chapter6-USDZPolish")
    }
}
