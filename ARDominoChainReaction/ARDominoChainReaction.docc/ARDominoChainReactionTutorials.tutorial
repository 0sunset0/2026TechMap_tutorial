@Tutorials(name: "AR 도미노 체인리액션") {
    @Intro(title: "AR 도미노 체인리액션 만들기") {
        ARDominoChainReaction은 카메라로 비추는 실제 공간에 가상의 도미노를 여러 개 세우고, 손끝으로
        밀어 연쇄 반응을 일으키는 AR 앱입니다.

        1장부터 6장까지, ARKit으로 공간을 인식하고, RealityKit으로 도미노를 세우고, 드래그로 밀어
        넘어뜨리는 체인리액션을 완성한 뒤, 마지막엔 실사 3D 모델로 다듬어 마무리합니다.

        ARKit과 RealityKit을 사용해본 경험은 없어도 됩니다. 평면 감지, 엔티티와 컴포넌트,
        3D 좌표계, 충돌과 임펄스는 각 장에서 코드와 함께 설명합니다. 3D 모델링 경험도 필요하지
        않습니다. 마지막 장에서 사용할 USDZ 모델은 다운로드할 수 있도록 제공합니다.

        @Image(source: domino-chain-reaction.gif, alt: "나무 도미노 여덟 개가 차례로 넘어지는 반복 애니메이션")
    }

    @Chapter(name: "1. 프로젝트 준비") {
        AR 앱은 왜 카메라 권한과 실기기가 필요한가.

        @Image(source: feature-points-illustration.png, alt: "프로젝트 준비")

        @TutorialReference(tutorial: "doc:Chapter0-ProjectSetup")
    }

    @Chapter(name: "2. 기본 AR 씬 띄우기") {
        ARSession과 평면 감지, UIKit↔SwiftUI 통합.

        @Image(source: feature-points-illustration.png, alt: "기본 AR 씬 띄우기")

        @TutorialReference(tutorial: "doc:Chapter1-BasicARScene")
    }

    @Chapter(name: "3. 도미노 한 개 만들기") {
        RealityKit의 Entity-Component-System.

        @Image(source: people-occlusion-illustration.png, alt: "도미노 한 개 만들기")

        @TutorialReference(tutorial: "doc:Chapter2-DominoEntity")
    }

    @Chapter(name: "4. 탭으로 하나씩 배치하기") {
        Raycasting과 보이지 않는 물리 바닥.

        @Image(source: tap-placement-illustration.png, alt: "탭으로 하나씩 배치하기")

        @TutorialReference(tutorial: "doc:Chapter3-TapPlacement")
    }

    @Chapter(name: "5. 드래그로 밀어 넘어뜨리기") {
        좌표계 변환과 Impulse.

        @Image(source: chain-reaction-illustration.png, alt: "드래그로 밀어 넘어뜨리기")

        @TutorialReference(tutorial: "doc:Chapter4-DragToPush")
    }

    @Chapter(name: "6. USDZ 모델로 다듬기") {
        절차적 mesh에서 USDZ 에셋으로.

        @Image(source: mesh-usdz-actual-comparison.png, alt: "USDZ 모델로 다듬기")

        @TutorialReference(tutorial: "doc:Chapter5-USDZPolish")
    }
}
