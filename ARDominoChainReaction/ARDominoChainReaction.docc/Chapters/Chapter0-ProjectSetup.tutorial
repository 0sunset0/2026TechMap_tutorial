@Tutorial(time: 10) {
    @Intro(title: "프로젝트 준비") {
        AR 앱은 카메라가 핵심이라 일반 앱과는 시작부터 다릅니다. 이 장에서는 프로젝트를 어떻게 만들어야 하는지,
        카메라 권한과 실기기가 왜 둘 다 필요한지부터 짚고 갑니다.

        @Image(source: feature-points-illustration.png, alt: "프로젝트 준비 장 배너")
    }

    @Section(title: "Xcode 프로젝트 만들기") {
        @ContentAndMedia {
            Xcode에는 "Augmented Reality App"이라는 템플릿이 따로 있지만, 이 프로젝트는 그 템플릿 대신
            일반 "App" 템플릿에서 시작합니다.
        }

        @Steps {
            @Step {
                Xcode에서 새 프로젝트를 생성하려면 **iOS** 탭을 선택한 다음, **App** 템플릿을
                선택합니다.

                > Note: "Augmented Reality App" 템플릿은 SceneKit 에셋 폴더나 독자적인 뷰컨트롤러
                > 구조 같은 보일러플레이트를 같이 만들어주는데, 이 프로젝트는 순정 SwiftUI 앱에서
                > 시작해서 `ARView`(RealityKit)를 직접 `UIViewRepresentable`로 감싸는 방식을 씁니다.
                > 템플릿 구조와 실제로 짤 코드 구조가 다르면 결국 지우고 다시 짜야 하니, 처음부터
                > 맞는 구조를 고르는 게 낫습니다.

                @Image(source: xcode-ios-app-template.png, alt: "Xcode 새 프로젝트 생성 창에서 iOS 탭과 App 템플릿이 선택된 예시")
            }

            @Step {
                제품 이름(Product Name)을 "ARDominoChainReaction"으로 설정합니다. Interface는
                **SwiftUI**, Language는 **Swift**를 선택합니다.

                @Image(source: xcode-project-options.png, alt: "Product Name은 ARDominoChainReaction, Interface는 SwiftUI, Language는 Swift로 설정한 프로젝트 옵션 예시")
            }

            @Step {
                프로젝트를 저장할 위치를 선택하고 **Create**를 클릭합니다. 이어지는 장부터 코드를
                작성할 준비가 끝났습니다.

                @Image(source: xcode-project-save.png, alt: "프로젝트 저장 위치로 Documents 아래 Developer 폴더를 선택하고 오른쪽 아래 Create 버튼을 누르는 예시")
            }
        }
    }

    @Section(title: "카메라 권한 설정하기") {
        @ContentAndMedia {
            AR 앱은 카메라 접근 권한이 없으면 아무것도 할 수 없습니다. 이 설정을 빠뜨리면 앱이 카메라에
            접근하는 순간 바로 크래시합니다.
        }

        @Steps {
            @Step {
                왼쪽 프로젝트 내비게이터에서 맨 위 프로젝트 파일(파란 아이콘)을 클릭합니다.

                @Image(source: xcode-select-project.png, alt: "프로젝트 내비게이터 맨 위 파란 프로젝트 아이콘 선택 위치")
            }

            @Step {
                가운데 편집 화면 왼쪽 사이드바의 **TARGETS** 아래에서 앱 타겟을 선택합니다.

                > Note: 바로 위에 있는 **PROJECT**가 아니라 **TARGETS** 쪽을 선택해야 합니다.

                @Image(source: xcode-select-app-target.png, alt: "PROJECT 아래 항목과 구분하여 TARGETS 아래 ARDominoChainReaction 앱 타겟을 선택한 모습")
            }

            @Step {
                상단 탭에서 **Info**를 클릭합니다.

                @Image(source: xcode-target-info-tab.png, alt: "앱 타겟 설정 상단의 Info 탭 선택 위치")
            }

            @Step {
                **Custom iOS Target Properties** 표에 마우스를 올리면 나타나는 `+` 버튼을 눌러
                새 키를 추가하고, `Privacy - Camera Usage Description`을 선택합니다.

                > Note: 같은 카메라 권한 설정도 확인하는 곳에 따라 이름이 다릅니다. Xcode의 Info
                > 탭에서는 `Privacy - Camera Usage Description`으로 표시되고, `Info.plist` 파일에는
                > `NSCameraUsageDescription`이라는 키로 저장됩니다.

                @Image(source: xcode-camera-usage-key.png, alt: "Custom iOS Target Properties의 더하기 버튼으로 Privacy - Camera Usage Description 키를 추가하는 예시")
            }

            @Step {
                키를 선택한 뒤, 같은 **Info** 탭에서 방금 추가한 행의 **Value** 칸(`String` 오른쪽)을
                더블 클릭합니다.

                "AR 도미노 체인리액션에서 ARKit 카메라 트래킹을 사용하기 위해 카메라 접근 권한이
                필요합니다."라고 입력합니다.

                @Image(source: xcode-camera-usage-value-filled.png, alt: "카메라 권한 행의 Value 칸에 지정된 카메라 접근 권한 요청 문구를 입력한 모습")
            }

            @Step {
                이 문구가 없으면 iOS가 카메라 API 호출 시점에 앱을 강제 종료시킵니다.

                > Note: iOS는 카메라 사용 목적을 설명하는 문구가 누락되면 개인정보 보호를 위해 앱을 종료합니다.

                @Image(source: camera-permission-missing.png, alt: "카메라 권한 문구 누락 상태에서 카메라에 접근하면 앱이 종료되는 흐름")
            }

            @Step {
                같은 **Info** 탭에 `Required device capabilities`(`UIRequiredDeviceCapabilities`)
                키를 추가하고 **Type**을 **Array**로 설정합니다. 왼쪽 삼각형을 눌러 배열을 펼친 뒤
                `+` 버튼으로 항목을 추가합니다. **Item 0**의 **Type**은 **String**, **Value**는
                `arkit`으로 설정합니다.

                > Note: 앱 실행 시 검사하는 값이 아니라, App Store가 ARKit 미지원 기기에는 이 앱을 아예
                > 노출·설치하지 않도록 미리 걸러주는 값입니다.

                @Image(source: xcode-arkit-capability.png, alt: "Required device capabilities 배열의 Item 0에 String 값 arkit을 입력한 모습")
            }

            @Step {
                같은 **Info** 탭에 `Requires full screen`(`UIRequiresFullScreen`) 키를 추가합니다.
                **Type**은 **Boolean**, **Value**는 **YES**로 설정합니다.

                > Note: AR 세션은 화면 일부만 쓰는 멀티태스킹(Split View, Slide Over)과 궁합이 안
                > 좋아서, iPad에서도 항상 전체 화면을 쓰도록 강제합니다.

                @Image(source: xcode-full-screen.png, alt: "Requires full screen의 Type을 Boolean, Value를 YES로 설정한 모습")
            }
        }
    }

    @Section(title: "실기기가 필요한 이유") {
        @ContentAndMedia {
            이 프로젝트는 시뮬레이터로 테스트할 수 없습니다.
        }

        @Steps {
            @Step {
                ARKit의 `ARWorldTrackingConfiguration`은 **A9 칩 이상** 기기가 필요합니다
                (iPhone 6s/SE 1세대 이후).

                @Image(source: arkit-real-device.png, alt: "ARKit 월드 트래킹의 A9 이상 칩과 실기기 카메라 요구 사항을 보여주는 그림")
            }

            @Step {
                시뮬레이터에는 카메라가 없어서, ARKit 세션에 필요한 실제 카메라 영상과 모션 센서
                데이터를 아예 얻을 수 없습니다.

                > Note: 이 튜토리얼은 모든 장을 실기기 빌드로만 확인할 수 있습니다.

                @Image(source: arkit-device-vs-simulator.png, alt: "AR 월드 트래킹에 필요한 카메라 영상과 모션 센서 입력을 실기기와 시뮬레이터에서 비교한 그림")
            }
        }
    }
}
