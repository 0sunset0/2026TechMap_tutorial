@Tutorial(time: 10) {
    @Intro(title: "프로젝트 준비") {
        AR 앱은 카메라가 핵심이라 일반 앱과는 시작부터 다릅니다. 이 장에서는 프로젝트를 어떻게 만들어야 하는지,
        카메라 권한과 실기기가 왜 둘 다 필요한지부터 짚고 갑니다.

        @Image(source: chapter0-banner.png, alt: "프로젝트 준비 장 배너")
    }

    @Section(title: "Xcode 프로젝트 만들기") {
        @ContentAndMedia {
            Xcode에는 "Augmented Reality App"이라는 템플릿이 따로 있지만, 이 프로젝트는 그 템플릿 대신
            일반 "App" 템플릿에서 시작하는 구조를 그대로 옮겨 [XcodeGen](https://github.com/yonaskolb/XcodeGen)의
            `project.yml`로 선언합니다.
        }

        @Steps {
            @Step {
                `project.yml`에 일반 iOS **App** 템플릿에 해당하는 타겟을 선언합니다.
                (Interface: SwiftUI, Language: Swift)

                @Code(name: "project.yml", file: "0-1-project.yml")
            }

            @Step {
                "Augmented Reality App" 템플릿을 쓰지 않는 이유가 있습니다. 그 템플릿은 SceneKit 에셋
                폴더나 독자적인 뷰컨트롤러 구조 같은 보일러플레이트를 같이 만들어주는데, 이 프로젝트는
                순정 SwiftUI 앱에서 시작해서 `ARView`(RealityKit)를 직접 `UIViewRepresentable`로
                감싸는 방식을 씁니다.

                > Note: 템플릿 구조와 실제로 짤 코드 구조가 다르면 결국 지우고 다시 짜야 하니, 처음부터
                > 맞는 구조를 고르는 게 낫습니다.

                @Code(name: "project.yml", file: "0-1-project.yml")
            }

            @Step {
                터미널에서 `brew install xcodegen`으로 XcodeGen을 설치합니다 (최초 1회만).
            }

            @Step {
                `ARDominoChainReaction` 폴더에서 `xcodegen generate`를 실행합니다.

                > Note: 이 프로젝트는 `.xcodeproj`를 커밋하지 않고 `project.yml`로부터 매번 생성합니다.
            }

            @Step {
                생성된 `ARDominoChainReaction.xcodeproj`를 엽니다. 이어지는 장부터 코드를 작성할 준비가
                끝났습니다.
            }
        }
    }

    @Section(title: "카메라 권한 설정하기") {
        @ContentAndMedia {
            AR 앱은 카메라 접근 권한이 없으면 아무것도 할 수 없습니다. 이 설정을 빠뜨리면 앱이 카메라에
            접근하는 순간 바로 크래시합니다.
        }

        @Steps {
            @Step {
                `NSCameraUsageDescription`(Privacy - Camera Usage Description)을 추가하고, 사용자에게
                보여줄 권한 요청 문구를 씁니다.

                @Code(name: "project.yml", file: "0-2a-project.yml")
            }

            @Step {
                이 문구가 없으면 iOS가 카메라 API 호출 시점에 앱을 강제 종료시킵니다.

                > Note: 런타임 에러가 아니라 보안 정책에 따른 의도된 종료예요.

                @Code(name: "project.yml", file: "0-2a-project.yml")
            }

            @Step {
                `UIRequiredDeviceCapabilities`에 `arkit`을 추가합니다.

                > Note: 앱 실행 시 검사하는 값이 아니라, App Store가 ARKit 미지원 기기에는 이 앱을 아예
                > 노출·설치하지 않도록 미리 걸러주는 값입니다.

                @Code(name: "project.yml", file: "0-2b-project.yml")
            }

            @Step {
                `UIRequiresFullScreen`도 함께 켭니다.

                > Note: AR 세션은 화면 일부만 쓰는 멀티태스킹(Split View, Slide Over)과 궁합이 안
                > 좋아서, iPad에서도 항상 전체 화면을 쓰도록 강제합니다.

                @Code(name: "project.yml", file: "0-2-project.yml")
            }

            @Step {
                이 세 값은 `project.yml`의 `info.properties`에 선언해두면, `xcodegen generate`가
                매번 `Sources/ARDominoChainReaction/Info.plist`에 그대로 반영합니다.

                @Code(name: "project.yml", file: "0-2-project.yml")
            }
        }
    }

    @Section(title: "실기기가 필요한 이유") {
        @ContentAndMedia {
            이 프로젝트는 시뮬레이터로 테스트할 수 없습니다.
        }

        @Steps {
            @Step {
                ARKit의 `ARWorldTrackingConfiguration`은 **A9 칩 이상** 기기가 필요합니다
                (iPhone 6s/SE 1세대 이후).
            }

            @Step {
                시뮬레이터에는 카메라가 없어서, ARKit 세션에 필요한 실제 카메라 영상과 모션 센서
                데이터를 아예 얻을 수 없습니다.

                > Note: 이 튜토리얼은 모든 장을 실기기 빌드로만 확인할 수 있습니다.
            }
        }
    }
}
