@Tutorial(time: 15) {
    @Intro(title: "USDZ 모델로 다듬기") {
        지금까지는 박스 모양 mesh로 도미노를 표현해왔습니다. 이번 장에서는 코드로 직접 그린 이 도형을
        실제 3D 모델(USDZ)로 바꿔보겠습니다. 이 장이 끝나면, 화면 속 도미노가 밋밋한 상자 대신 나무
        재질의 진짜 도미노처럼 보일 거예요.

        @Image(source: mesh-usdz-actual-comparison.png, alt: "USDZ 모델로 다듬기 장 배너")
    }

    @Section(title: "제공된 USDZ 에셋 다운로드하기") {
        @ContentAndMedia {
            USDZ는 ARKit과 RealityKit이 공식 지원하는 3D 파일 포맷입니다. 이 튜토리얼에서는 직접
            모델링하지 않고, 미리 만들어둔 `domino.usdz` 파일을 씁니다.
        }

        @Steps {
            @Step {
                아래 링크에서 `domino.usdz` 파일을 받으세요.

                > Note: 직접 만든 3D 모델이라 다른 챕터의 Swift 코드처럼 타이핑해서 만들 수 없는
                > 바이너리 에셋입니다.

                [domino.usdz 다운로드](https://raw.githubusercontent.com/0sunset0/2026TechMap_tutorial/main/ARDominoChainReaction/Sources/ARDominoChainReaction/domino.usdz)

                @Image(source: finder-domino-download.png, alt: "Finder의 다운로드 폴더에서 domino.usdz 파일 이름과 확장자를 확인하는 예시")

            }

            @Step {
                다운로드한 파일을 macOS **Quick Look**(파일 선택 후 스페이스바)으로 먼저 열어보세요.

                > Note: 나무 재질의 도미노 모델이 잘 보이면 준비 완료입니다.

                @Image(source: domino-usdz-preview.png, alt: "domino.usdz 모델의 모습: 나뭇결 재질의 각진 직육면체 도미노")
            }

            @Step {
                Xcode 프로젝트의 `Sources/ARDominoChainReaction` 그룹으로 파일을 드래그해 추가합니다.

                @Image(source: xcode-usdz-import.png, alt: "Finder의 domino.usdz 파일을 Xcode 프로젝트 탐색기의 Sources 아래 ARDominoChainReaction 그룹으로 드래그하는 예시")
            }

            @Step {
                **타겟 멤버십**(대상 앱 타겟 체크박스)이 체크됐는지 꼭 확인하세요.

                > Note: 빠지면 실행 시 모델을 못 찾아 런타임 에러가 납니다.

                @Image(source: xcode-target-membership.png, alt: "domino.usdz를 선택한 뒤 오른쪽 File Inspector의 Target Membership에서 ARDominoChainReaction 앱 타겟이 체크된 모습")
            }
        }
    }

    @Section(title: "코드로 그린 mesh를 USDZ 모델로 교체하기") {
        @ContentAndMedia {
            지금까지 `makeDominoEntity()`는 `MeshResource.generateBox`와 `PhysicallyBasedMaterial`로
            모양을 만들었습니다. 이 부분을 방금 추가한 USDZ 파일을 불러오는 코드로 바꿔보겠습니다.

            @Image(source: mesh-usdz-actual-comparison.png, alt: "빨간 박스와 실제 domino.usdz의 나뭇결 직육면체 모델을 나란히 렌더링한 비교 이미지")
        }

        @Steps {
            @Step {
                **기존의 mesh 생성 + 재질 설정 코드를, USDZ 파일을 동기적으로 불러오는 한 줄로
                대체합니다.**

                > Note: 파일 이름은 확장자 없이 씁니다. `domino.usdz`는 앱 번들에 포함돼 있어
                > 로드가 항상 성공하므로, `try!`로 실패 시 바로 크래시시켜 문제를 즉시
                > 알아챕니다. 작은 파일 하나만 불러오는 정도라 동기 로드로도 화면이 멈추지
                > 않습니다.

                > Note: USDZ 파일 안에 이미 나무 재질과 색상 정보가 담겨 있어서,
                > `PhysicallyBasedMaterial`을 직접 만들 필요가 없어집니다.

                @Code(name: "ARCoordinator.swift", file: "5-1a-ARCoordinator.swift", previousFile: "5-context-ARCoordinator.swift")
            }

            @Step {
                충돌 shape과 물리 바디는 이전과 똑같이 붙입니다.

                > Note: mesh로 만들었든 USDZ로 불러왔든, `domino`는 여전히 같은 `ModelEntity`
                > 타입입니다. `generateCollisionShapes`와 `PhysicsBodyComponent`는 mesh나
                > 재질이 아니라 이 `ModelEntity` 자체에 컴포넌트를 붙이는 코드라서, 모양을
                > 만드는 방식이 바뀌어도 그대로 재사용할 수 있습니다.

                @Code(name: "ARCoordinator.swift", file: "5-1-ARCoordinator.swift", previousFile: "5-1a-ARCoordinator.swift")
            }
        }
    }

    @Section(title: "크기와 피벗 다시 맞추기") {
        @ContentAndMedia {
            지금까지의 `dominoSize`(0.08, 0.2, 0.04) 상수는 박스 mesh를 기준으로 정한 값입니다. 새로
            불러온 USDZ 모델은 실제 크기나 원점(피벗) 위치가 이 값과 다를 수 있어서, 그대로 두면
            도미노가 바닥에 파묻히거나 떠서 보일 수 있습니다.
        }

        @Steps {
            @Step {
                `domino.visualBounds(relativeTo: nil)`로 불러온 모델의 실제 크기(바운딩 박스)를
                확인합니다.

                > Note: 코드의 가정만으로는 정확한 값을 알 수 없어서, 실제로 불러온 모델의
                > 바운딩 박스를 직접 구해서 쓰는 게 안전합니다.

                @Code(name: "ARCoordinator.swift", file: "5-2a-ARCoordinator.swift", previousFile: "5-1-ARCoordinator.swift")
            }

            @Step {
                `place(_:at:in:)`에서 쓰던 오프셋을 실제 모델 크기 기준으로 다시 계산합니다.

                > Note: `dominoSize.y`는 예전 박스 mesh 기준 고정값이라 실제 모델 높이와
                > 다를 수 있어 `bounds.extents.y`로 바꿉니다. `generateCollisionShapes`는
                > 새 모델 모양에 맞춰 자동으로 계산되니 그대로 다시 호출해도 됩니다.

                @Code(name: "ARCoordinator.swift", file: "5-2b-ARCoordinator.swift", previousFile: "5-2a-ARCoordinator.swift")
            }

            @Step {
                더 이상 어디서도 쓰이지 않는 `dominoSize` 상수는 이 시점에 함께 삭제합니다.

                > Note: 삭제한 줄은 코드 diff에 따로 표시되지 않습니다. 클래스 위쪽에서 아래
                > 줄을 직접 찾아 지우세요.
                >
                > `private let dominoSize = SIMD3<Float>(0.08, 0.2, 0.04)`

                @Code(name: "ARCoordinator.swift", file: "5-2-ARCoordinator.swift", previousFile: "5-2b-ARCoordinator.swift")
            }
        }
    }

    @Section(title: "실기기에서 비교 확인하기") {
        @ContentAndMedia {
            마지막으로 실기기에서 결과를 직접 확인해봅니다.
        }

        @Steps {
            @Step {
                실기기에서 앱을 다시 빌드해보세요.

                > Note: 탭해서 세운 도미노가 빨간 박스 대신 나무 재질의 3D 모델로 보일 거예요.

                @Image(source: domino-usdz-real-device.png, alt: "카펫 바닥 위에 나뭇결 도미노 한 개가 서 있고, 화면 상단에 '도미노 3개 배치됨 — 계속 탭해서 줄을 세워보세요' 배너가 표시된 AR 앱 실행 화면")
            }

            @Step {
                **AR 도미노 체인리액션 앱을 완성했습니다! 🎉**

                실제 공간을 인식하고, 도미노를 배치하고, 손끝으로 연쇄 반응을 일으키는 앱을
                직접 만들었습니다. 이제 도미노의 간격과 배치를 바꿔 나만의 체인리액션을 만들어보세요.

                @Image(source: domino-blender-demo.gif, alt: "실제 USDZ 나무 모델을 사용해 Blender 물리 시뮬레이션으로 재현한 도미노 연쇄 반응")
            }
        }
    }
}
